{
  "manifest_version": 3,
  "name": "Screen Receiver 送信",
  "version": "0.1.0",
  "description": "Chrome の画面を、Screen Receiver アプリ（Android）へ、Wi-Fi で映します。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "画面を Android に映す"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "sender.html",
        "icons/icon16.png"
      ],
      "matches": [
        "http://*/*"
      ]
    }
  ]
}
